    "programs": [
        {
            "name": "main",
            "source": "clear()\nwhile num_items(Items.Hay)<34500:\n    while get_pos_x()>0:\n        move(West)\n    while get_pos_y()>0:\n        move(South)\n    for row in range(get_world_size()):\n        for col in range(get_world_size()):\n            if can_harvest():\n                harvest()\n            if get_water()<0.3 and num_items(Items.Water)>0:\n                use_item(Items.Water)\n            if col+1<get_world_size():\n                move(East)\n        while get_pos_x()>0:\n            move(West)\n        if row+1<get_world_size():\n            move(North)\n    while get_pos_y()>0:\n        move(South)"
        }
    ],
