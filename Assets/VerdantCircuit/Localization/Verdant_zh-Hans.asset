  - m_Id: 1040444682133514
    m_Localized: "\u5E76\u884C\u7814\u7A76\u5C06\u5BB9\u91CF\u4ECE1\u63D0\u5347\u52302\u30014\u30018\u300116\u300132\uFF1B\u4E3B\u63A7\u5236\u7A0B\u5E8F\u4E5F\u5360\u69FD\u4F4D\u3002spawn_drone(function,\u53C2\u6570...)
      \u8FD4\u56DE\u53E5\u67C4\uFF0C\u69FD\u6EE1\u8FD4\u56DE None\u3002\u5DE5\u4F5C\u673A\u62FF\u5230\u72EC\u7ACB\u53D8\u91CF\u548C\u96C6\u5408\u526F\u672C\uFF0C\u4F46\u5171\u4EAB\u7530\u5730\u548C\u5E93\u5B58\uFF0C\u53EF\u4EE5\u540C\u683C\u79FB\u52A8\uFF0C\u4E0D\u53D1\u751F\u5B9E\u4F53\u78B0\u649E\u3002\n\n\u6309\u5217\u6216\u5206\u533A\u5DE5\u4F5C\uFF0C\u907F\u514D\u4E24\u53F0\u673A\u5668\u540C\u65F6\u5728\u4E00\u683C\u79CD\u690D\u3001\u4E89\u62A2\u79CD\u5B50\u3002\u4FDD\u5B58\u53E5\u67C4\uFF0C\u518D\u9010\u4E2A
      wait_for() \u53D6\u8FD4\u56DE\u503C\uFF1Bhas_finished() \u4E0D\u7B49\u5F85\u53EA\u67E5\u8BE2\u3002\u5DE5\u4F5C\u673A\u4FEE\u6539
      global \u4E0D\u4F1A\u6539\u53D8\u63A7\u5236\u7A0B\u5E8F\u526F\u672C\uFF0C\u8BF7\u7528
      return \u4F20\u9012\u7ED3\u679C\u3002\u5B8C\u6210\u540E\u69FD\u4F4D\u4F1A\u91CA\u653E\u3002\n\n\u751F\u6210\u5931\u8D25\u65F6\u7531\u4E3B\u63A7\u5236\u7A0B\u5E8F\u63A5\u624B\u4EFB\u52A1\u3002\u8FBE\u6807\u540E\u4ECD\u6709\u5DE5\u4F5C\u673A\u4E0D\u505C\u6267\u884C\u7684\u7A0B\u5E8F\u4E0D\u80FD\u5B8C\u6210\u8D44\u6E90\u7ADE\u901F\u3002"
