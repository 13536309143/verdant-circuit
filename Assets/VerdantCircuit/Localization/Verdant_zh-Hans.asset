  - m_Id: 1121342031126623
    m_Localized: "\u516D\u5EA7\u5C9B\u7684\u72EC\u7ACB\u4ED3\u5E93\u6784\u6210\u751F\u4EA7\u56FE\uFF1A\u7089\u5FC3\u79CD\u8C37\u7269\uFF1B\u82C7\u6CFD\u4F9B\u6C34\uFF1B\u4F59\u70EC\u7528\u77FF\u77F3\uFF0B\u8C37\u7269\uFF0B\u6C34\u51B6\u70BC\u5408\u91D1\uFF1B\u7409\u5149\u7528\u5408\u91D1\uFF0B\u6C34\u63D0\u70BC\u6676\u4F53\uFF1B\u82B1\u6C50\u7528\u8C37\u7269\uFF0B\u6676\u4F53\uFF0B\u6C34\u751F\u4EA7\u836F\u5242\uFF1B\u5929\u7A79\u628A\u5408\u91D1\uFF0B\u6676\u4F53\uFF0B\u836F\u5242\u7EC4\u88C5\u4E3A\u6838\u5FC3\u3002\u5C9B\u5C7F\u540C\u65F6\u8981\u6C42\u8BA2\u5355\u8FDB\u5EA6\u4E0E\u4E3B\u519C\u573A\u53D1\u73B0\uFF1A\u80E1\u841D\u535C\uFF0F\u5357\u74DC\uFF0F\u4ED9\u4EBA\u638C\uFF0F\u8FF7\u5BAB\uFF0F\u957F\u5C3E\uFF0F\u81EA\u6CBB\u4FE1\u6807\u3002\u5E93\u5B58\u6309\u5C9B\u72EC\u7ACB\uFF0Cnum_items(Items.Water)
      \u4E0D\u7B49\u4E8E fleet_stock(\u5C9B\u5C7F,\"water\")\u3002\n\n\u7528 fleet_map
      \u67E5\u8BE2\u5404\u5C9B\u5730\u56FE\u4E0E\u8FDE\u63A5\u56FE\u3002\u5BBD\u901A\u9053\u7EC4\u6210\u5411\u4E1C\uFF0F\u5411\u897F\u7684\u5355\u5411\u73AF\u8DEF\uFF1B\u5C0F\u673A\u4F53\u53EF\u7A7F\u7A84\u9053\u3002\u8D27\u8FD0\u6307\u4EE4\u63A5\u53D7\u65F6\u9884\u7559\u771F\u5B9E\u6E90\u4ED3\u5E93\u5B58\uFF0C\u8FD0\u8F93\u673A\u518D\u524D\u5F80\u7801\u5934\u88C5\u8D27\uFF0C\u6CBF\u8FDE\u63A5\u822A\u9053\u9010\u6BB5\u822A\u884C\uFF0C\u5E76\u7B49\u5F85\u5B8C\u6574\u5360\u5730\u53EF\u964D\u843D\u3002\u5DF2\u9884\u7559\u548C\u5728\u9014\u8D27\u7269\u4E0D\u80FD\u91CD\u590D\u6295\u5165\u914D\u65B9\u6216\u8BA2\u5355\u3002\n\n18\u5355\u8981\u6C42\u591A\u4E2A\u54C1\u7C7B\u3001\u591A\u4E2A\u76EE\u7684\u5730\u540C\u65F6\u5907\u9F50\uFF0C\u5168\u90E8\u4EA4\u4ED8\u53EA\u6263\u4E00\u6B21\u5217\u660E\u7684\u672C\u5730\u5E93\u5B58\u3002\u540E\u7EED\u4EFB\u52A1\u8FD8\u8BA4\u8BC1\u5B9E\u9645\u673A\u4F53\u4F5C\u4E1A\u3001\u4E0D\u540C\u5B50\u7A0B\u5E8F\u5E76\u53D1\u548C\u540C\u65F6\u822A\u884C\uFF1B\u6E05\u5355\u4F1A\u663E\u793A\u672C\u5355\u5CF0\u503C\u4E0E\u76EE\u6807\u3002\u6CA1\u6709\u6309\u79D2\u6570\u653E\u884C\u7684\u8BA4\u8BC1\u3002\u7FA4\u5C9B\u6D41\u7A0B\u8854\u63A5\u4E3B\u519C\u573A\uFF1B\u7F16\u8F91\u3001\u6392\u9519\u4E0E\u4EA4\u9519\u751F\u4EA7\u4F1A\u6539\u53D8\u603B\u901A\u5173\u65F6\u95F4\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1121342031126624
    m_Localized: "19 / \u591A\u7FA4\u5C9B\u5206\u5C42\u7F16\u7A0B"
    m_Metadata:
      m_Items: []
  - m_Id: 1121342031126625
    m_Localized: "\u5728\u7FA4\u5C9B\u754C\u9762\u521B\u5EFA10\u6587\u4EF6\u6A21\u5757\u5316\u8303\u4F8B\u3002island_controller
      \u5BFC\u5165 island_planner\uFF0C\u603B\u63A7\u5206\u914D\u5B9E\u4F53\u673A\u3001\u5C55\u5F00\u914D\u65B9\u4F9D\u8D56\uFF0C\u518D\u628A\u5DE5\u4F5C\u53D1\u9001\u5230\u5355\u673A\u6536\u4EF6\u7BB1\u3002fleet_worker
      \u662F\u5171\u4EAB\u51FD\u6570\u5E93\uFF1Bisland_water\uFF0Fisland_grain\uFF0Fisland_foundry\uFF0Fisland_crystal\uFF0Fisland_medicine\uFF0Fisland_archive\uFF0Fisland_cargo
      \u5206\u522B\u5BFC\u5165\u5B83\uFF0C\u5E76\u9650\u5236\u5404\u81EA\u53EF\u52A0\u5DE5\u7684\u914D\u65B9\u3002\n\nfleet_run(id,\u6587\u4EF6\u540D)
      \u4E3A\u5B9E\u4F53\u673A\u7ED1\u5B9A\u72EC\u7ACB\u89E3\u91CA\u5668\u3002\u81EA\u52A8\u6CE8\u5165
      unit_id \u4E0E\u542F\u52A8\u65F6\u7684 island_id\uFF1Bfleet_self() \u8FD4\u56DE\u672C\u673A\u7F16\u53F7\u3002\u5B50\u7A0B\u5E8F\u53EF\u4EE5\u7EE7\u7EED\u5BFC\u5165\u5176\u4ED6\u6587\u4EF6\u3001\u5B9A\u4E49\u51FD\u6570\u5E76\u4EA7\u751F\u8FD4\u56DE\u7ED3\u679C\u3002\u6536\u4EF6\u7BB1\u590D\u5236\u6D88\u606F\u5185\u5BB9\uFF0C\u6BCF\u53F0\u673A\u5668\u90FD\u6709\u81EA\u5DF1\u7684\u53D8\u91CF\u4E0E\u6A21\u5757\u72B6\u6001\u3002fleet_send
      \u53D1\u9001\u4EFB\u52A1\uFF1Bfleet_receive \u63A5\u6536\u672C\u673A\u4E0B\u4E00\u6761\u6D88\u606F\uFF1Bfleet_result
      \u8BFB\u53D6\u7ED3\u675F\u540E\u7684 result \u53D8\u91CF\u3002\u67D0\u53F0\u673A\u5668\u62A5\u9519\u53EA\u505C\u6B62\u8BE5\u5B50\u7A0B\u5E8F\uFF0C\u5361\u7247\u663E\u793A\u9519\u8BEF\uFF0C\u5176\u4ED6\u673A\u5668\u548C\u7269\u7406\u961F\u5217\u7EE7\u7EED\u3002\u65E0\u9650\u5FAA\u73AF\u53D7\u6BCF\u4E2A\u6A21\u62DF\u6B65\u7684\u6307\u4EE4\u9884\u7B97\u9650\u5236\uFF0C\u4E0D\u4F1A\u5361\u4F4F\u6574\u4E2A\u4E16\u754C\u3002\n\n\u7269\u7406\u4EFB\u52A1\u3001\u9884\u7559\u539F\u6599\u4E0E\u5728\u9014\u8D27\u7269\u4F1A\u4FDD\u5B58\uFF1BPython\u8C03\u7528\u6808\u3001\u6D88\u606F\u6536\u4EF6\u7BB1\u548C\u8FD4\u56DE\u5BF9\u8C61\u4E0D\u4FDD\u5B58\u3002\u8F7D\u5165\u540E\u91CD\u65B0\u8FD0\u884C\u603B\u63A7\uFF0C\u6216\u4E3A\u5355\u673A\u91CD\u65B0\u7ED1\u5B9A\u7A0B\u5E8F\uFF0C\u5148\u68C0\u67E5\u5DF2\u6709\u4EFB\u52A1\u518D\u53D1\u9001\uFF0C\u907F\u514D\u91CD\u590D\u3002\u505C\u6B62\u4EE3\u7801\u7ED3\u675F\u89E3\u91CA\u5668\uFF1B\u53D6\u6D88\u961F\u5217\u53D6\u6D88\u5DF2\u964D\u843D\u7684\u7269\u7406\u4EFB\u52A1\u3002\u4E3B\u519C\u573A\u8FD0\u884C\u6309\u94AE\u542F\u52A8\u603B\u63A7\uFF1B\u673A\u961F\u5361\u7247\u7684\u7ED1\u5B9A\u5E76\u8FD0\u884C\u542F\u52A8\u5355\u673A\u5B50\u7A0B\u5E8F\u3002"
    m_Metadata:
      m_Items: []
