  - m_Id: 1040444682133510
    m_Localized: "\u79CD\u4E00\u682A\u704C\u6728\uFF0C\u4F7F\u7528\u8DB3\u91CF\u5947\u5F02\u7269\u8D28\u751F\u6210\u8FDE\u901A\u8FF7\u5BAB\u3002can_move()
      \u6D4B\u5899\uFF0Cmove() \u8FD4\u56DE\u79FB\u52A8\u662F\u5426\u6210\u529F\uFF0Cmeasure()
      \u8FD4\u56DE\u5B9D\u85CF\u5750\u6807\u3002\u5230\u5B9D\u85CF\u6536\u83B7\u91D1\u5E01\uFF1B\u8BEF\u6536\u6811\u7BF1\u4F1A\u6E05\u9664\u8FF7\u5BAB\uFF0C\u5F97\u4E0D\u5230\u5B9D\u85CF\u5956\u52B1\u3002\n\n\u7528
      visited \u96C6\u5408\u548C\u65B9\u5411\u6808\u8FDB\u884C\u6DF1\u5EA6\u4F18\u5148\u641C\u7D22\u3002\u63A2\u7D22\u6CA1\u53BB\u8FC7\u7684\u90BB\u683C\uFF0C\u8D70\u4E0D\u52A8\u65F6\u6309\u6808\u53CD\u65B9\u5411\u56DE\u6EAF\u3002\u8FF7\u5BAB\u590D\u7528\u4F1A\u62C6\u5899\u4EA7\u751F\u73AF\uFF0C\u6240\u4EE5
      visited \u5FC5\u4E0D\u53EF\u5C11\u3002\u5B9D\u85CF\u6309\u7167\u771F\u5B9E\u901A\u9053\u8DDD\u79BB\u9009\u5728\u8DB3\u591F\u8FDC\u7684\u4F4D\u7F6E\uFF0C\u4E0D\u4F1A\u91CD\u590D\u51FA\u73B0\u5728\u811A\u4E0B\u3002\n\n\u5230\u5B9D\u85CF\u540E\u7528\u5947\u5F02\u7269\u8D28\u66FF\u4EE3
      harvest()\uFF0C\u4F1A\u53D1\u91D1\u5E01\u5E76\u4FDD\u7559\u5E03\u5C40\u3001\u8FC1\u79FB\u5B9D\u85CF\uFF1B\u6E05\u7A7A
      visited \u518D\u627E\u4E0B\u4E00\u8F6E\u3002\u590D\u7528\u6D88\u8017\u6750\u6599\uFF0C\u6700\u591A300\u6B21\uFF0C\u7136\u540E\u6536\u83B7\u5E76\u91CD\u65B0\u751F\u6210\u8FF7\u5BAB\u3002"
    m_Metadata:
      m_Items: []
