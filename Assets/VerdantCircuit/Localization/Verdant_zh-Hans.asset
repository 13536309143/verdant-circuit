  - m_Id: 1040444677939222
    m_Localized: "\u4ECE\u4E00\u683C\u8349\u5730\u3001\u96F6\u5E93\u5B58\u5F00\u59CB\u3002\u8349\u4F1A\u81EA\u7136\u6210\u719F\uFF0C\u8FD0\u884C
      harvest()\uFF0C\u6512\u591F\u4E94\u4EFD\u5E72\u8349\u540E\u7814\u7A76\u5FAA\u73AF\uFF0C\u518D\u4ECE\u6A21\u677F\u8F7D\u5165\u7B2C\u4E00\u4EFD\u6536\u83B7\u3002\n\n\u4E4B\u540E\u7814\u7A76\u8FD0\u7B97\u7B26\u3001\u53D8\u91CF\u3001\u4F20\u611F\u5668\u548C\u79CD\u690D\u3002\u5E93\u5B58\u591F\u7528\u4E0D\u7B49\u4E8E\u81EA\u52A8\u7814\u7A76\uFF1A\u5728\u79D1\u6280\u6811\u70B9\u51FB\u4ED8\u8D39\uFF0C\u6216\u540E\u7EED\u8C03\u7528
      unlock()\u3002\u8349\u548C\u704C\u6728\u4E0D\u6D88\u8017\u79CD\u5B50\uFF0C\u539F\u6599\u7528\u5B8C\u4ECD\u53EF\u6062\u590D\u751F\u4EA7\u3002\n\n\u672C\u7248\u76EE\u6807\u662F\u6709\u53EF\u8FD0\u884C\u81EA\u52A8\u5316\u7B56\u7565\u65F6\uFF0C\u7EA6\u4E09\u5C0F\u65F6\u6E38\u620F\u65F6\u95F4\u5B8C\u6210\u5168\u90E8\u7814\u7A76\uFF1B\u7F16\u7A0B\u4E0E\u601D\u8003\u53E6\u8BA1\u3002\u6B63\u5E38
      1 \u500D\u901F\u4FDD\u7559\u79D1\u6280\u52A0\u901F\uFF0C\u8BBE\u7F6E\u4E2D\u7684\u500D\u7387\u4F1A\u52A0\u5FEB\u6574\u4E2A\u4E16\u754C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939223
    m_Localized: "02 / \u7A0B\u5E8F\u4E0E\u72B6\u6001"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939224
    m_Localized: "\u7A0B\u5E8F\u4E5F\u662F\u53EF\u590D\u7528\u6A21\u5757\u3002\u7A0B\u5E8F\u5E93\u6309\u6587\u4EF6\u663E\u793A\u5361\u7247\uFF0C\u5E76\u663E\u793A\u603B\u6570\u3001\u6D3B\u8DC3\u7A0B\u5E8F\u6570\u548C\u65E0\u4EBA\u673A\u69FD\u4F4D\u3002\u7EFF\u8272\u8868\u793A\u8FD8\u6709\u5DE5\u4F5C\u673A\u5728\u8FD0\u884C\uFF1B\u7425\u73C0\u8272\u8FB9\u6846\u8868\u793A\u5F53\u524D\u4E3B\u7F16\u8F91\u5668\u6253\u5F00\u7684\u6587\u4EF6\u3002\u540C\u4E00\u4E2A\u7A0B\u5E8F\u53EF\u4EE5\u540C\u65F6\u5904\u4E8E\u8FD0\u884C\u548C\u7F16\u8F91\u72B6\u6001\u3002\u6682\u505C\u4ECD\u7B97\u6D3B\u8DC3\uFF0C\u7A7A\u95F2\u8868\u793A\u6CA1\u6709\u5B58\u6D3B\u5DE5\u4F5C\u673A\u3002\n\n\u7F16\u8F91\u53EA\u5207\u6362\u67E5\u770B\uFF0C\u4E0D\u4F1A\u505C\u6B62\u5DF2\u6709\u5DE5\u4F5C\u3002\u4E3B\u8FD0\u884C\u6309\u94AE\u4F1A\u66FF\u6362\u63A7\u5236\u7A0B\u5E8F\u53CA\u5176\u5168\u90E8\u5DE5\u4F5C\u673A\u3002\u7A97\u53E3\u6309\u94AE\u6253\u5F00\u53EF\u62D6\u52A8\u7F16\u8F91\u5668\uFF0C\u72EC\u7ACB\u8FD0\u884C\u5728\u6709\u7A7A\u4F59\u69FD\u4F4D\u65F6\u542F\u52A8\u6587\u4EF6\u3002\u5168\u90E8\u505C\u6B62\u4F1A\u7ED3\u675F\u6240\u6709\u4EFB\u52A1\u3002\u5173\u95ED\u7F16\u8F91\u7A97\u53E3\u4E0D\u5220\u9664\u4EE3\u7801\uFF0C\u4E5F\u4E0D\u505C\u6B62\u4EFB\u52A1\uFF1B\u6D3B\u8DC3\u7A0B\u5E8F\u4E0D\u80FD\u5220\u9664\uFF0C\u81F3\u5C11\u4FDD\u7559\u4E00\u4E2A\u6587\u4EF6\u3002\n\nCmd/Ctrl+Z
      \u64A4\u9500\uFF0CCmd/Ctrl+Shift+Z \u91CD\u505A\uFF1BF9 \u5728\u5149\u6807\u884C\u5207\u6362\u65AD\u70B9\u3002\u7528\u6682\u505C\u3001\u5355\u6B65\u548C\u53D8\u91CF\u76D1\u89C6\u5B9A\u4F4D\u95EE\u9898\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939225
    m_Localized: "03 / \u8BED\u8A00\u57FA\u7840"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939226
    m_Localized: "\u89E3\u91CA\u5668\u91C7\u7528\u7C7B Python \u8BED\u6CD5\uFF0C\u5E76\u4E0D\u662F\u5B8C\u6574
      Python \u73AF\u5883\u3002\u6BCF\u5C42\u7F29\u8FDB\u56DB\u4E2A\u7A7A\u683C\u6216\u4E00\u4E2A
      Tab\uFF0C\u4E0D\u8981\u6DF7\u7528\u3002\u540D\u79F0\u548C\u679A\u4E3E\u5927\u5C0F\u5199\u654F\u611F\uFF1B\u53D8\u91CF\u3001\u6761\u4EF6\u3001\u51FD\u6570\u3001\u96C6\u5408\u9700\u8981\u5BF9\u5E94\u8BED\u8A00\u7814\u7A76\u3002\u8BBE\u7F6E\u4E2D\u5141\u8BB8\u672A\u89E3\u9501\u8BED\u6CD5\u53EA\u79FB\u9664\u8BED\u6CD5\u95E8\u69DB\uFF0C\u4E0D\u8D60\u9001\u4F5C\u7269\u4E0E\u7814\u7A76\u3002\n\n\u652F\u6301
      if/elif/else\u3001while\u3001for\u3001break/continue\u3001\u5E26\u53C2\u51FD\u6570\u3001\u9ED8\u8BA4\u53C2\u6570\u3001return\u3001global\u3001\u6A21\u5757\u5BFC\u5165\u3001\u5217\u8868\u3001\u4E0D\u53EF\u53D8\u5143\u7EC4\u3001\u96C6\u5408\u3001\u5B57\u5178\u3001\u7D22\u5F15\u3001\u89E3\u5305\u4E0E\u95ED\u5305\u3002\u4E0D\u63D0\u4F9B
      Python \u6807\u51C6\u5E93\u6216\u64CD\u4F5C\u7CFB\u7EDF\u8BBF\u95EE\u3002\u6BD4\u8F83\u7528
      ==\uFF0C\u8D4B\u503C\u7528 =\uFF1B\u8D1F\u7D22\u5F15\u4ECE\u672B\u5C3E\u8BA1\u6570\u3002\n\n\u8C03\u8BD5\u53EF\u7528
      print()\uFF0C\u9891\u7E41\u8F93\u51FA\u6709\u6267\u884C\u6210\u672C\u3002\u6CA1\u6709\u9000\u51FA\u6761\u4EF6\u7684
      while \u4F1A\u4E00\u76F4\u8FD0\u884C\u5230\u70B9\u51FB\u505C\u6B62\uFF1B\u6709\u9650\u751F\u4EA7\u4EFB\u52A1\u53EF\u6309\u5E93\u5B58\u8BBE\u5B9A\u76EE\u6807\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939227
    m_Localized: "04 / \u5206\u9636\u6BB5\u7814\u7A76"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939228
    m_Localized: "\u7814\u7A76\u5206\u4E3A\u4E09\u79CD\u6761\u4EF6\uFF1A\u524D\u7F6E\u53D1\u73B0\u3001\u7D2F\u8BA1\u751F\u4EA7\u548C\u5B9E\u9645\u4ED8\u8D39\u3002\u7D2F\u8BA1\u751F\u4EA7\u7EDF\u8BA1\u6210\u529F\u6536\u83B7\uFF0C\u5373\u4F7F\u8D44\u6E90\u5DF2\u7ECF\u82B1\u6389\u4E5F\u7B97\u5B8C\u6210\uFF0C\u4E0D\u4F1A\u518D\u6263\u4E00\u6B21\uFF1B\u79D1\u6280\u6811\u663E\u793A\u5F53\u524D\u91CF\u4E0E\u76EE\u6807\u3002\u53D1\u73B0\u65B0\u4F5C\u7269\u540E\u624D\u9010\u6B65\u5F00\u653E\u7530\u89C4\u6A21\u3001\u901F\u5EA6\u548C\u589E\u4EA7\u7B49\u7EA7\u3002\n\n\u519C\u7530\u89C4\u6A21\uFF1A\u79CD\u690D\u21922\xD72\u3001\u6797\u6728\u21924\xD74\u3001\u5357\u74DC\u21928\xD78\u3001\u4ED9\u4EBA\u638C\u219216\xD716\u3001\u957F\u5C3E\u219232\xD732\uFF1B\u6BCF\u7EA7\u4ECD\u9700\u652F\u4ED8\u6269\u7530\u6210\u672C\u3002\u66F4\u65B0\u4FDD\u7559\u5DF2\u8D2D\u7814\u7A76\uFF0C\u5B8C\u6574\u4F53\u9A8C\u65B0\u8FDB\u5EA6\u8BF7\u65B0\u5EFA\u519C\u573A\u3002\n\nget_cost()
      \u67E5\u8BE2\u4EF7\u683C\uFF0Cget_unlock_requirements() \u67E5\u8BE2\u95E8\u69DB\uFF0Ccan_unlock()
      \u540C\u65F6\u68C0\u67E5\u95E8\u69DB\u548C\u5E93\u5B58\u3002\u6761\u4EF6\u4E0D\u9F50\u65F6
      unlock() \u8FD4\u56DE False\uFF0C\u4E0D\u6263\u8D44\u6E90\u3002\u6CA1\u6709\u56FA\u5B9A\u65F6\u957F\u8BA4\u8BC1\u3002\u4E0B\u9762\u5217\u51FA\u5404\u5347\u7EA7\u7B49\u7EA7\u6240\u9700\u7684\u53D1\u73B0\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939229
    m_Localized: "05 / \u4F5C\u7269\u4E0E\u4F9B\u5E94\u94FE"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939230
    m_Localized: "\u8349\u4EA7\u5E72\u8349\uFF0C\u704C\u6728\u4E0E\u6811\u4EA7\u6728\u6750\u3002\u80E1\u841D\u535C\u9700\u8981\u8015\u5730\u3001\u5E72\u8349\u548C\u6728\u6750\uFF1B\u5357\u74DC\u4E0E\u592A\u9633\u82B1\u6D88\u8017\u80E1\u841D\u535C\uFF0C\u4ED9\u4EBA\u638C\u6D88\u8017\u5357\u74DC\u3002\u589E\u4EA7\u7814\u7A76\u4E5F\u4F1A\u63D0\u9AD8\u79CD\u5B50\u6210\u672C\uFF1B\u94FA\u7530\u524D\u7528
      get_cost(Entities.Carrot) \u67E5\u79CD\u5B50\u4EF7\u683C\uFF0C\u5E76\u4E3A\u591A\u8F6E\u8865\u79CD\u9884\u7559\u539F\u6599\u3002\n\n\u79CD\u690D\u8981\u6C42\u7A7A\u683C\u548C\u5408\u9002\u5730\u9762\uFF0C\u67AF\u6B7B\u5357\u74DC\u53EF\u76F4\u63A5\u8865\u79CD\u3002till()
      \u5207\u6362\u5730\u9762\uFF1B\u6E05\u7530\u548C\u6269\u7530\u4F1A\u91CD\u7F6E\u7530\u5730\u3001\u635F\u5931\u5728\u7530\u4F5C\u7269\u3002\u6574\u7530\u6362\u4F5C\u7269\u4E4B\u524D\u5148\u7559\u8DB3\u5E93\u5B58\u3002\n\n\u6BCF\u682A\u76F8\u90BB\u6811\u90FD\u4F1A\u8FDB\u4E00\u6B65\u62D6\u6162\u6811\u6728\u751F\u957F\uFF0C\u63A8\u8350\u6811\u4E0E\u704C\u6728\u68CB\u76D8\u4EA4\u66FF\u3002\u666E\u901A\u519C\u7530\u8D8A\u754C\u73AF\u7ED5\uFF0C\u6700\u53F3\u5217\u518D\u5411\u4E1C\u4F1A\u56DE\u5230\u7B2C\u96F6\u5217\uFF1B\u8FF7\u5BAB\u548C\u957F\u5C3E\u4E0D\u80FD\u73AF\u7ED5\u3002\u65E0\u6C34\u57FA\u7840\u751F\u957F\u65F6\u95F4\uFF1A\u83493\u79D2\u3001\u704C\u67284\u79D2\u3001\u68116\u79D2\u3001\u80E1\u841D\u535C7\u79D2\u3001\u5357\u74DC11\u79D2\u3001\u592A\u9633\u82B18.5\u79D2\u3001\u4ED9\u4EBA\u638C1.5\u79D2\uFF1B\u6D47\u6C34\u4F1A\u52A0\u5FEB\u751F\u957F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1040444677939231
