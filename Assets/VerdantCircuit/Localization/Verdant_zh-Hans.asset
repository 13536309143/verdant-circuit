  - m_Id: 1040444677939232
    m_Localized: "\u704C\u6E89\u7814\u7A76\u6BCF\u5341\u4E2A\u6E38\u620F\u79D2\u4EA7\u751F\u6C34\u3002\u4E00\u4EFD\u6C34\u589E\u52A00.25\u6C34\u5206\uFF0C\u4E0A\u96501.0\uFF0C\u6C34\u5206\u4F1A\u9010\u6E10\u8870\u51CF\u3002\u4EC5\u5728\u6C34\u5206\u4F4E\u4E8E\u9608\u503C\u4E14\u5E93\u5B58\u6709\u6C34\u65F6\u704C\u6E89\uFF1B\u5982\u679C\u9608\u503C\u8BBE\u4E3A0.3\uFF0C\u5730\u5757\u7EA650%\u6C34\u5206\u65F6\u4E0D\u6D47\u6C34\u662F\u9884\u671F\u884C\u4E3A\u3002\n\n\u80A5\u6599\u540C\u6837\u6BCF\u5341\u79D2\u81EA\u52A8\u4EA7\u751F\uFF1B\u4F7F\u7528\u540E\u589E\u52A0\u6210\u957F\u5E76\u611F\u67D3\u672C\u682A\u3002\u5408\u5E76\u5357\u74DC\u6216\u4ED9\u4EBA\u638C\u6536\u83B7\u65F6\uFF0C\u5947\u5F02\u7269\u8D28\u6309\u611F\u67D3\u682A\u6570\u6BD4\u4F8B\u8BA1\u7B97\uFF0C\u4E00\u682A\u611F\u67D3\u4E0D\u4F1A\u628A\u6574\u7530\u7684\u4E00\u534A\u53D8\u6210\u5947\u5F02\u7269\u8D28\u3002\u80A5\u6599\u50AC\u719F\u4E5F\u4F1A\u6267\u884C\u6B63\u5E38\u5357\u74DC\u6B7B\u4EA1\u5224\u5B9A\u3002\n\n\u5947\u5F02\u7269\u8D28\u7FFB\u8F6C\u672C\u683C\u53CA\u53BB\u91CD\u540E\u7684\u76F8\u90BB\u683C\u611F\u67D3\u72B6\u6001\uFF1B\u5BF9\u704C\u6728\u4F7F\u7528\u8DB3\u91CF\u7269\u8D28\u4F1A\u751F\u6210\u8FF7\u5BAB\uFF0C\u6D88\u8017\u4E3A\u8FB9\u957F\xD72^(\u8FF7\u5BAB\u7B49\u7EA7\u22121)\uFF1B\u5BF9\u5B9D\u85CF\u4F7F\u7528\u76F8\u540C\u6570\u91CF\u4F1A\u7ED9\u91D1\u5E01\u5E76\u590D\u7528\u8FF7\u5BAB\uFF0C\u6700\u591A\u590D\u7528300\u6B21\u3002"
    m_Metadata:
      m_Items: []
