    m_Metadata:
      m_Items: []
  - m_Id: 1280139257176158
    m_Localized: "\u6E38\u620F\u89E3\u91CA\u5668\u662F\u660E\u786E\u8BB0\u5F55\u7684Python\u5B50\u96C6\uFF0C\u4E0D\u662F\u7CFB\u7EDFPython\u3002\u652F\u6301\u5FAA\u73AF\u3001\u6761\u4EF6\u3001\u51FD\u6570\u3001\u95ED\u5305\u3001\u9ED8\u8BA4\u503C\u3001\u4F4D\u7F6E\u53C2\u6570\u3001\u96C6\u5408\u3001\u6A21\u5757\u548C\u8FD4\u56DE\u503C\uFF1B\u4E0D\u63D0\u4F9B\u64CD\u4F5C\u7CFB\u7EDF\u3001\u6587\u4EF6\u3001\u7F51\u7EDC\u3001\u6807\u51C6\u5E93\u8BBF\u95EE\uFF0C\u4E5F\u4E0D\u652F\u6301\u5F02\u5E38\u6355\u83B7\u4E0E\u5173\u952E\u5B57\u53C2\u6570\u3002\u65B0\u589Esum\u3001enumerate\u3001zip\u3001sorted\u3001reversed\u3001round\u3001all\u3001any\u3001pow\u3001divmod\u3001type\u3001Unicode\u548C\u5B57\u7B26\u4E32\u65B9\u6CD5\uFF0C\u9010\u9879\u89C1\u63A5\u53E3\u8BF4\u660E\u3002\u96C6\u5408\u64CD\u4F5C\u8FD4\u56DE\u5FEB\u7167\u5217\u8868\uFF0C\u800C\u975EPython\u60F0\u6027\u8FED\u4EE3\u5668\u6216\u89C6\u56FE\uFF1B\u6570\u503C\u4F7F\u7528\u7EDF\u4E00\u8868\u793A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1280139257176159
    m_Localized: "06 / \u7A0B\u5E8F\u6267\u884C\u76EE\u6807"
    m_Metadata:
