  - m_Id: 1262209932976193
    m_Localized: "\u5730\u7403\u519C\u52A1\u673A\u6267\u884C\u539F\u6709\u4F5C\u7269\u51FD\u6570\uFF0C\u64CD\u4F5C\u540C\u4E00\u7247\u5730\u7403\u519C\u7530\u548C\u539F\u6709\u5E93\u5B58\uFF0C\u6BCF\u53F0\u6709\u72EC\u7ACB\u5750\u6807\u4E0E\u53D8\u91CF\u3002\u6301\u4E45\u5DE5\u4F5C\u673A\u901A\u8FC7fleet_build\u5EFA\u9020\uFF0C\u518D\u7528program_bind\u3001program_run\u7ED1\u5B9A\u8FD0\u884C\uFF1B\u539F\u6709spawn_drone(\u51FD\u6570,\u53C2\u6570...)\u5728\u5730\u7403\u519C\u52A1\u7A0B\u5E8F\u4E2D\u521B\u5EFA\u4E34\u65F6\u5B50\u673A\uFF0C\u7ED3\u675F\u91CA\u653E\u69FD\u4F4D\uFF0Cwait_for\u53D6\u5F97\u8FD4\u56DE\u503C\u3002\n\n\u673A\u7FA4\u7528group_create(\u540D\u79F0,[\u7F16\u53F7...])\u521B\u5EFA\uFF0C\u518Dgroup_run(\u540D\u79F0,\u6587\u4EF6)\u3002\u5404\u6210\u5458\u72EC\u7ACB\u6267\u884C\u540C\u4E00\u6587\u4EF6\uFF0C\u901A\u8FC7fleet_self\u8BC6\u522B\u81EA\u8EAB\uFF0C\u4E0D\u5171\u4EAB\u53EF\u53D8\u53D8\u91CF\uFF0C\u534F\u4F5C\u9700\u6D88\u606F\u901A\u4FE1\u3002\u7BA1\u7406\u7A0B\u5E8F\u4E0D\u5360\u5B9E\u4F53\u65E0\u4EBA\u673A\u540D\u989D\u3002\u519C\u52A1\u673A\u4E3A1\xD71\uFF1B\u4E13\u7528\u673A\u4F7F\u7528\u5DF2\u7814\u7A76\u7684\u77E9\u5F62\u5B9E\u4F53\u901A\u884C\u3002\u5730\u7403\u4F5C\u7269\u7F51\u683C\u4FDD\u7559\u539F\u6709\u98DE\u884C\u5668\u53EF\u8DE8\u8D8A\u540C\u683C\u7684\u89C4\u5219\u3002"
