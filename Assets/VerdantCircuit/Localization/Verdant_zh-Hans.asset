  - m_Id: 1040444677939234
    m_Localized: "\u5357\u74DC\u5728\u6210\u719F\u65F6\u670920%\u6982\u7387\u67AF\u6B7B\u3002\u53CD\u590D\u626B\u63CF\u5B8C\u6574\u65B9\u9635\uFF0C\u8865\u79CD
      Dead_Pumpkin\uFF1B\u4FEE\u590D\u671F\u95F4\u4E0D\u8981\u5355\u72EC\u6536\u5272\u5065\u5EB7\u5357\u74DC\u3002\u76EE\u6807\u65B9\u9635\u7684\u6BCF\u4E00\u683C\u90FD\u6210\u719F\u540E\u624D\u6536\u83B7\u3002\u6E38\u620F\u4F1A\u5408\u5E76\u5305\u542B\u6536\u83B7\u70B9\u7684\u6700\u5927\u5B8C\u6574\u65B9\u9635\u3002\n\n\u8FB9\u957Fn\u7684\u4EA7\u91CF\u4E3A
      n\xB2\xD7min(n,6)\xD7\u672C\u7EA7\u5355\u682A\u4EA7\u91CF\u3002\u8981\u68C0\u67E5\u6574\u5757\u7530\uFF0C\u4E0D\u80FD\u53EA\u68C0\u67E5\u811A\u4E0B\u4E00\u683C\uFF1B\u9884\u7559\u8865\u79CD\u79CD\u5B50\u3002\u751F\u4EA7\u5947\u5F02\u7269\u8D28\u65F6\uFF0C\u6210\u719F\u540E\u5BF9\u9700\u8981\u7684\u682A\u6570\u65BD\u80A5\uFF0C\u518D\u5408\u5E76\u6536\u83B7\u3002\u7D2F\u8BA1\u8FDB\u5EA6\u770B
      num_produced()\uFF0C\u53EF\u652F\u4ED8\u5E93\u5B58\u770B num_items()\u3002"
    m_Metadata:
      m_Items: []
