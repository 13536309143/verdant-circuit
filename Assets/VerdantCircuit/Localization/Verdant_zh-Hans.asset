      m_Items: []
  - m_Id: 662229213245
    m_Localized: "\u514D\u8D39\u7684\u7A3B\u7A57\uFF0C\u662F\u8FD9\u7247\u571F\u5730\u7684\u7B2C\u4E00\u4EFD\u793C\u7269\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213246
    m_Localized: "\u6309\u7A7A\u683C\u64AD\u79CD\uFF0C\u6216\u6267\u884C plant(grain)\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213247
    m_Localized: "\u7B2C\u4E00\u4EFD\u6536\u6210"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213248
    m_Localized: "\u91D1\u8272\u7A57\u5934\u51FA\u73B0\u65F6\uFF0C\u7A3B\u7A57\u5C31\u6210\u719F\u4E86\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213249
    m_Localized: "\u6309 E \u6536\u83B7\uFF1B\u811A\u672C\u7528 if ready(): \u5224\u65AD\u6210\u719F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213250
    m_Localized: "\u4ECE\u91CD\u590D\u4E2D\u89E3\u653E"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213251
    m_Localized: "\u8BA9\u4EE3\u7801\u5B8C\u6210\u4F60\u5DF2\u7ECF\u5B66\u4F1A\u7684\u52A8\u4F5C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213252
    m_Localized: "\u8F7D\u5165\u300C\u7A3B\u7A57\u5DE1\u7530\u300D\u6A21\u677F\uFF0C\u70B9\u51FB\u8FD0\u884C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213253
    m_Localized: "\u9A6C\u8FBE\u7684\u4F4E\u8BED"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213254
    m_Localized: "\u4E00\u53F0\u66F4\u654F\u6377\u7684\u673A\u5668\u4EBA\uFF0C\u80FD\u7167\u770B\u66F4\u5927\u7684\u7530\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213255
    m_Localized: "\u5728\u300C\u79D1\u6280\u300D\u9875\u8D2D\u4E70\u8F7B\u91CF\u9A6C\u8FBE\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213256
    m_Localized: "\u5FAA\u73AF\u5DE1\u7530"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213257
    m_Localized: "\u91CD\u590D\u4E0D\u662F\u8D1F\u62C5\uFF0C\u800C\u662F\u4E00\u6BB5\u53EF\u4EE5\u590D\u7528\u7684\u7A0B\u5E8F\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213258
    m_Localized: "while True: \u4F1A\u6301\u7EED\u8FD0\u884C\uFF0C\u968F\u65F6\u53EF\u4EE5\u505C\u6B62\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213259
    m_Localized: "\u6839\u7CFB\u5411\u4E0B"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213260
    m_Localized: "\u841D\u535C\u559C\u6B22\u677E\u8F6F\u7684\u571F\u3002\u5148\u7FFB\u571F\uFF0C\u518D\u64AD\u79CD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213261
    m_Localized: "till() \u7FFB\u571F\uFF1Bplant(radish) \u64AD\u79CD\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213262
    m_Localized: "\u5411\u4E1C\u5F00\u57A6"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213263
    m_Localized: "\u8BA9\u66F4\u591A\u571F\u5730\u52A0\u5165\u4F60\u7684\u5FAA\u73AF\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 662229213264
    m_Localized: "\u7814\u7A76\u300C\u5F00\u57A6\u4E1C\u5CB8\u300D\uFF0C\u5FAA\u73AF\u7528
