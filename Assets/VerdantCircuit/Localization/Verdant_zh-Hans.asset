  - m_Id: 1040444682133518
    m_Localized: "\u4E00\u76F4\u957F\u4E0D\u51FA\u4F5C\u7269\uFF1A\u68C0\u67E5\u5BF9\u5E94\u7814\u7A76\u3001\u79CD\u5B50\u5E93\u5B58\u3001\u5730\u9762\u548C\u7A7A\u683C\u3002plant()
      \u5931\u8D25\u8FD4\u56DE False\uFF0C\u5728\u7A7A\u5730\u4E0A\u7B49\u6210\u719F\u4E0D\u4F1A\u4EA7\u751F\u4F5C\u7269\u3002\n\n\u7269\u8D44\u591F\u5374\u7814\u7A76\u4E0D\u4E86\uFF1A\u67E5\u770B\u4E0B\u4E00\u7EA7\u6240\u9700\u4F5C\u7269\u53D1\u73B0\u548C\u7D2F\u8BA1\u4EA7\u91CF\u3002\u6267\u884C\u901F\u5EA6\u4E0E\u589E\u4EA7\u73B0\u5728\u4E0D\u80FD\u4E00\u6B21\u5168\u90E8\u5F00\u653E\u3002\n\n\u5357\u74DC\u4E0D\u80FD\u5408\u5E76\uFF1A\u68C0\u67E5\u6BCF\u683C\u662F\u5426\u67AF\u6B7B\u6216\u672A\u6210\u719F\u3002\u4ED9\u4EBA\u638C\u4E0D\u8FDE\u6536\uFF1A\u627E\u5411\u4E1C/\u5317\u9006\u5E8F\u6216\u672A\u6210\u719F\u683C\u3002\u80FD\u91CF\u8017\u5149\uFF1A\u51CF\u5C11\u91CD\u590D\u79FB\u52A8\u4E0E\u626B\u63CF\u3002\u8FF7\u5BAB\u5361\u4F4F\uFF1A\u4F7F\u7528
      visited \u548C\u56DE\u6EAF\uFF0C\u8FF7\u5BAB\u6CA1\u6709\u666E\u901A\u73AF\u7ED5\u3002\u65E0\u4EBA\u673A
      global \u4E0D\u8FD4\u56DE\uFF1A\u7528 wait_for() \u63A5\u6536\u8FD4\u56DE\u503C\u3002\n\n\u7528F9\u65AD\u70B9\u3001\u6682\u505C\u548C\u5355\u6B65\u9010\u884C\u68C0\u67E5\uFF1B\u8BED\u6CD5\u9519\u8BEF\u5E26\u884C\u53F7\u3002\u5907\u4EFD\u6587\u4EF6\u4EE5
      .bak \u7ED3\u5C3E\u3002\u519C\u573A\u5E93\u521B\u5EFA\u72EC\u7ACB\u5B58\u6863\u53CA\u7A0B\u5E8F\u76EE\u5F55\u3002\u5916\u90E8\u7F16\u8F91\u5668\u4F1A\u5BFC\u51FA
      .py \u548C __builtins__.py \u63D0\u793A\u5E76\u76D1\u89C6\u4FDD\u5B58\uFF0C\u907F\u514D\u4E24\u5904\u540C\u65F6\u6539\u540C\u4E00\u6587\u4EF6\u3002\u97F3\u91CF\u6ED1\u6761\u677E\u5F00\u65F6\u4FDD\u5B58\u3002\n\n\u66F4\u65B0\u540E\u6D4B\u8BD5\u5B8C\u6574\u8FDB\u5EA6\u5EFA\u8BAE\u65B0\u5EFA\u519C\u573A\u3002\u65E7\u89C4\u5219\u83B7\u5F97\u7684\u8D44\u6E90\u4E0D\u4F1A\u88AB\u8FFD\u56DE\u3002"
