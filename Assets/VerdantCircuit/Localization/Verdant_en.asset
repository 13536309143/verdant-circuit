  - m_Id: 392000787439624
    m_Localized: 'harvest() / can_harvest()

      plant(Entities.Grass) / plant(Entities.Bush)
      / plant(Entities.Tree)

      plant(Entities.Carrot) / plant(Entities.Pumpkin)

      plant(Entities.Sunflower)
      / plant(Entities.Cactus)

      move(North / East / South / West) -> True /
      False

      can_move(direction) -> True / False

      till() / use_item(Items.Water)
      / use_item(Items.Fertilizer)

      get_pos_x() / get_pos_y() / get_world_size()

      get_entity_type()
      / get_ground_type() / get_water()

      num_items(Items.Hay) / num_unlocked(Unlocks.Speed)

      get_cost(Unlocks.Speed)
      / unlock(Unlocks.Speed)

      get_companion() -> (entity, (x, y)) or None

      measure()
      / measure(direction) / swap(direction)

      spawn_drone(function, args...)
      -> handle or None

      wait_for(handle) -> return value / has_finished(handle)

      num_drones()
      / max_drones()

      get_time() / get_tick_count() / random()

      simulate(file,
      unlocks, items, globals, seed, speedup)

      change_hat(Hats.Straw_Hat) /
      change_hat(Hats.Dinosaur_Hat)

      set_world_size(size) / set_execution_speed(speed)

      clear()
      / do_a_flip()

      print(values...) / quick_print(values...)


      Namespaces:
      Entities, Items, Grounds, Unlocks, Hats, Leaderboards.

      Programs: import
      helpers / from helpers import tend.

      Collections: [1,2], (1,2), {1,2},
      {''seed'': 4}.

      Data: values[0], costs[''hay''], values.append(3), visited.add((x,y)).

      Functions:
      def work(x, count=1): ... return result.


      A task has independent memory.
      Return values are collected by wait_for().

      A blocked maze move returns
      False. Normal field edges wrap; tail mode does not.

      Simulation creates
      a new isolated farm. It cannot modify the live inventory.'
    m_Metadata:
      m_Items: []
