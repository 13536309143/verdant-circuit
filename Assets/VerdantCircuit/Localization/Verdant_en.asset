  - m_Id: 1300716885893129
    m_Localized: Mothership
    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893130
    m_Localized: "Every interplanetary route docks at the mothership. Use depot \u22121
      to store and retrieve goods there."
    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893131
    m_Localized: Refuel at current dock
    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893132
    m_Localized: Consume 20 local solar energy for 100 battery charge.
    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893133
