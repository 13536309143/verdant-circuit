  m_TableData:
  - m_Id: 662225018880
    m_Localized: Arrival at Verdant Bay
    m_Metadata:
      m_Items: []
  - m_Id: 662229213184
    m_Localized: The Power of Loops
    m_Metadata:
      m_Items: []
  - m_Id: 662229213185
    m_Localized: Water and Soil
    m_Metadata:
      m_Items: []
  - m_Id: 662229213186
    m_Localized: Companion Gardens
    m_Metadata:
      m_Items: []
  - m_Id: 662229213187
    m_Localized: Precision Farming
    m_Metadata:
      m_Items: []
  - m_Id: 662229213188
    m_Localized: The Starbloom Project
    m_Metadata:
      m_Items: []
  - m_Id: 662229213189
    m_Localized: Grain
    m_Metadata:
      m_Items: []
  - m_Id: 662229213190
    m_Localized: Free to plant. A reliable starter crop that grows faster in moist
      soil.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213191
    m_Localized: Radish
    m_Metadata:
      m_Items: []
  - m_Id: 662229213192
    m_Localized: Requires tilled soil. Fertile soil increases the harvest yield.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213193
    m_Localized: Blue Flax
    m_Metadata:
      m_Items: []
  - m_Id: 662229213194
    m_Localized: Adjacent grain increases yield. Try alternating rows or a checkerboard.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213195
    m_Localized: Blueberry
    m_Metadata:
      m_Items: []
  - m_Id: 662229213196
    m_Localized: Needs moist soil. Regrows twice after the first harvest.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213197
    m_Localized: Sunflower
    m_Metadata:
      m_Items: []
  - m_Id: 662229213198
    m_Localized: Harvest mature sunflowers to store energy for starblooms.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213199
    m_Localized: Honey Pumpkin
    m_Metadata:
      m_Items: []
  - m_Id: 662229213200
    m_Localized: Requires tilled soil. Adjacent mature pumpkins increase harvest
      yield.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213201
    m_Localized: Cloud Tea
    m_Metadata:
      m_Items: []
  - m_Id: 662229213202
    m_Localized: Needs irrigation. Crowded tea loses yield; nearby sunflowers increase
      it.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213203
    m_Localized: Starbloom
    m_Metadata:
      m_Items: []
  - m_Id: 662229213204
    m_Localized: Requires tilled, moist soil and 3 energy per planting. Nearby tea
      increases research.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213205
    m_Localized: Lightweight Motor
    m_Metadata:
      m_Items: []
  - m_Id: 662229213206
    m_Localized: Shortens the action interval by 25%.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213207
    m_Localized: Selected Seeds
    m_Metadata:
      m_Items: []
  - m_Id: 662229213208
    m_Localized: Adds 1 to the base yield of every crop.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213209
    m_Localized: East Bank Expansion
    m_Metadata:
      m_Items: []
  - m_Id: 662229213210
    m_Localized: Expands the field from 4x4 to 6x6.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213211
    m_Localized: Fiber Crops
    m_Metadata:
      m_Items: []
  - m_Id: 662229213212
    m_Localized: Unlocks blue flax and companion-crop bonuses.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213213
    m_Localized: Water Storage
    m_Metadata:
      m_Items: []
  - m_Id: 662229213214
    m_Localized: Unlocks irrigation, blueberries and sunflowers.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213215
    m_Localized: Compost Cycle
    m_Metadata:
      m_Items: []
  - m_Id: 662229213216
    m_Localized: Unlocks fertilizing. Fertile soil improves yield.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213217
    m_Localized: Servo Motor
    m_Metadata:
      m_Items: []
  - m_Id: 662229213218
    m_Localized: Further speeds up robot actions.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213219
    m_Localized: Water-Retaining Soil
    m_Metadata:
      m_Items: []
  - m_Id: 662229213220
    m_Localized: Halves the rate of moisture loss.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213221
    m_Localized: Patch Farming
    m_Metadata:
      m_Items: []
  - m_Id: 662229213222
    m_Localized: Unlocks pumpkins and mature-neighbor harvest bonuses.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213223
    m_Localized: West Slope Expansion
    m_Metadata:
      m_Items: []
  - m_Id: 662229213224
    m_Localized: Expands the field to 8x8.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213225
    m_Localized: Seed Improvement
    m_Metadata:
      m_Items: []
  - m_Id: 662229213226
    m_Localized: Adds another 1 to every crop's base yield.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213227
    m_Localized: Solar Collection
    m_Metadata:
      m_Items: []
  - m_Id: 662229213228
    m_Localized: Doubles the energy obtained from sunflowers.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213229
    m_Localized: Cloud Tea Garden
    m_Metadata:
      m_Items: []
  - m_Id: 662229213230
    m_Localized: Unlocks cloud tea and flower-tea companion planting.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213231
    m_Localized: Living Soil
    m_Metadata:
      m_Items: []
  - m_Id: 662229213232
    m_Localized: Halves the fertility lost on harvest.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213233
    m_Localized: Quantum Scheduling
    m_Metadata:
      m_Items: []
  - m_Id: 662229213234
    m_Localized: Reduces the action interval to 0.08 seconds.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213235
    m_Localized: Starbloom Greenhouse
    m_Metadata:
      m_Items: []
  - m_Id: 662229213236
    m_Localized: Unlocks starblooms, which consume energy when planted.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213237
    m_Localized: Ecology Lab
    m_Metadata:
      m_Items: []
  - m_Id: 662229213238
    m_Localized: Increases harvest research by 50%.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213239
    m_Localized: Verdant Autonomy Station
    m_Metadata:
      m_Items: []
  - m_Id: 662229213240
    m_Localized: 'The final project: establish a self-running farm.'
    m_Metadata:
      m_Items: []
  - m_Id: 662229213241
    m_Localized: First Steps
    m_Metadata:
      m_Items: []
  - m_Id: 662229213242
    m_Localized: Welcome to Verdant Bay. Get to know your field robot.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213243
    m_Localized: Use the arrow keys or WASD; click a plot to navigate.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213244
    m_Localized: Seeds of Hope
    m_Metadata:
      m_Items: []
  - m_Id: 662229213245
    m_Localized: Free grain is this land's first gift to you.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213246
    m_Localized: Press Space to plant, or call plant(grain).
    m_Metadata:
      m_Items: []
  - m_Id: 662229213247
    m_Localized: The First Harvest
    m_Metadata:
      m_Items: []
  - m_Id: 662229213248
    m_Localized: Golden heads mean the grain is ready to harvest.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213249
    m_Localized: 'Press E to harvest; use if ready(): in code.'
    m_Metadata:
      m_Items: []
  - m_Id: 662229213250
    m_Localized: Beyond Repetition
    m_Metadata:
      m_Items: []
  - m_Id: 662229213251
    m_Localized: Let code perform the actions you already know.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213252
    m_Localized: Load the Grain Patrol template and click Run.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213253
    m_Localized: A Quieter Motor
    m_Metadata:
      m_Items: []
  - m_Id: 662229213254
    m_Localized: A more agile robot can tend a larger field.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213255
    m_Localized: Buy Lightweight Motor on the Research screen.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213256
    m_Localized: Patrol Loop
    m_Metadata:
      m_Items: []
  - m_Id: 662229213257
    m_Localized: Repetition is a reusable piece of code.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213258
    m_Localized: 'while True: keeps running until you stop it.'
    m_Metadata:
      m_Items: []
  - m_Id: 662229213259
    m_Localized: Roots Below
    m_Metadata:
      m_Items: []
  - m_Id: 662229213260
    m_Localized: Radishes prefer loose soil. Till first, then plant.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213261
    m_Localized: Use till(), followed by plant(radish).
    m_Metadata:
      m_Items: []
  - m_Id: 662229213262
    m_Localized: Expand East
    m_Metadata:
      m_Items: []
  - m_Id: 662229213263
    m_Localized: Bring more land into your loop.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213264
    m_Localized: Research East Bank Expansion. Use size() so loops adapt.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213265
    m_Localized: Blue Fiber
    m_Metadata:
      m_Items: []
  - m_Id: 662229213266
    m_Localized: Grow flax beside grain and observe the companion bonus.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213267
    m_Localized: Research Fiber Crops; nearby grain increases flax yield.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213268
    m_Localized: A Thousand Small Things
    m_Metadata:
      m_Items: []
  - m_Id: 662229213269
    m_Localized: Reliable automation is built from many small actions.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213270
    m_Localized: Scan the field with for y in range(size()):.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213271
    m_Localized: Moisture changes growth speed and fades over time.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213272
    m_Localized: After researching Water Storage, water() irrigates the current plot.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213273
    m_Localized: A Patch of Blueberries
    m_Metadata:
      m_Items: []
  - m_Id: 662229213274
    m_Localized: For a perennial crop, harvesting need not mean starting again.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213275
    m_Localized: Blueberries need moist soil. Each plant can be harvested three times.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213276
    m_Localized: Save the Sunshine
    m_Metadata:
      m_Items: []
  - m_Id: 662229213277
    m_Localized: Harvest sunflowers and store energy for future experiments.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213278
    m_Localized: Each sunflower harvest also produces energy.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213279
    m_Localized: The Soil Cycle
    m_Metadata:
      m_Items: []
  - m_Id: 662229213280
    m_Localized: Fertility improves the amount you harvest.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213281
    m_Localized: Research Compost Cycle first. Each fertilizer application costs
      2 coins.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213282
    m_Localized: The Rhythm of Water
    m_Metadata:
      m_Items: []
  - m_Id: 662229213283
    m_Localized: Make irrigation part of your program.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213284
    m_Localized: 'Use if moisture() < 0.6: water(). Retaining soil and rain can keep
      moisture above 50%.'
    m_Metadata:
      m_Items: []
  - m_Id: 662229213285
    m_Localized: A Honey-Colored Patch
    m_Metadata:
      m_Items: []
  - m_Id: 662229213286
    m_Localized: Let adjacent pumpkins mature before harvesting.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213287
    m_Localized: Mature neighboring pumpkins increase yield; harvest order matters.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213288
    m_Localized: Evidence of Companionship
    m_Metadata:
      m_Items: []
  - m_Id: 662229213289
    m_Localized: Relationships between plants can be programmed too.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213290
    m_Localized: Grain with flax, or flowers with tea, can trigger bonuses.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213291
    m_Localized: The West Slope
    m_Metadata:
      m_Items: []
  - m_Id: 662229213292
    m_Localized: A larger field calls for a better patrol loop.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213293
    m_Localized: Research West Slope Expansion to scan all 64 plots.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213294
    m_Localized: Reliable Scheduling
    m_Metadata:
      m_Items: []
  - m_Id: 662229213295
    m_Localized: Keep the program reliable as the world gets larger.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213296
    m_Localized: Pause to inspect the current line; Step helps with debugging.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213297
    m_Localized: Harvest Engineering
    m_Metadata:
      m_Items: []
  - m_Id: 662229213298
    m_Localized: Turn small harvests into a steady supply.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213299
    m_Localized: Try seed and water-retention research, then compare income rates.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213300
    m_Localized: Tea in the Mist
    m_Metadata:
      m_Items: []
  - m_Id: 662229213301
    m_Localized: Tea needs water and space for its roots.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213302
    m_Localized: Crowded tea loses yield. Alternate it with sunflowers.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213303
    m_Localized: Put Experience into Functions
    m_Metadata:
      m_Items: []
  - m_Id: 662229213304
    m_Localized: Wrap repeated farm actions in a function, then call it from a loop.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213305
    m_Localized: 'Define def tend(): and call tend().'
    m_Metadata:
      m_Items: []
  - m_Id: 662229213306
    m_Localized: Make Every Drop Count
    m_Metadata:
      m_Items: []
  - m_Id: 662229213307
    m_Localized: Efficiency comes from decisions, not blind repetition.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213308
    m_Localized: Combine moisture(), ready() and crop() to choose the next action.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213309
    m_Localized: A Thousand in Storage
    m_Metadata:
      m_Items: []
  - m_Id: 662229213310
    m_Localized: Verdant Bay is no longer an untended field.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213311
    m_Localized: Open Storage to inspect crop stocks and growing rules.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213312
    m_Localized: A Precise Heartbeat
    m_Metadata:
      m_Items: []
  - m_Id: 662229213313
    m_Localized: A shorter action cycle calls for clearer code.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213314
    m_Localized: Research Servo Motor, then Quantum Scheduling.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213315
    m_Localized: Turn sunlight into crops and crops into knowledge.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213316
    m_Localized: Starblooms require tea research. Keep sunflower energy in reserve.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213317
    m_Localized: The First Starlight
    m_Metadata:
      m_Items: []
  - m_Id: 662229213318
    m_Localized: Starblooms need moisture, tilled soil and energy together.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213319
    m_Localized: Each starbloom planting costs 3 energy. Adjacent tea boosts research.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213320
    m_Localized: Ten Thousand Actions Together
    m_Metadata:
      m_Items: []
  - m_Id: 662229213321
    m_Localized: Every action begins with a rule you wrote.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213322
    m_Localized: Check that the program replants, irrigates and handles immature
      crops.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213323
    m_Localized: Autonomy Online
    m_Metadata:
      m_Items: []
  - m_Id: 662229213324
    m_Localized: Build the final project to connect the farm's autonomy system.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213325
    m_Localized: Keep improving the economy through greenhouse and ecology research.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213326
    m_Localized: Verdant Bay, Alight
    m_Metadata:
      m_Items: []
  - m_Id: 662229213327
    m_Localized: You finished the main campaign. The field and its possibilities
      keep growing.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213328
    m_Localized: Complete the six trials, collect achievements or keep optimizing
      your farm.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213329
    m_Localized: Grain Express
    m_Metadata:
      m_Items: []
  - m_Id: 662229213330
    m_Localized: Root Experiment
    m_Metadata:
      m_Items: []
  - m_Id: 662229213331
    m_Localized: Water-Wise Growing
    m_Metadata:
      m_Items: []
  - m_Id: 662229213332
    m_Localized: Pumpkin Patch
    m_Metadata:
      m_Items: []
  - m_Id: 662229213333
    m_Localized: Flowers and Tea
    m_Metadata:
      m_Items: []
  - m_Id: 662229213334
    m_Localized: Starlight Circuit
    m_Metadata:
      m_Items: []
  - m_Id: 662229213335
    m_Localized: Harvest 90 grain within 150 seconds using a scanning loop.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213336
    m_Localized: Harvest 80 radishes within 180 seconds. Handle tilling and replanting.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213337
    m_Localized: Harvest 80 blueberries within 210 seconds. Manage moisture and regrowth.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213338
    m_Localized: Harvest 90 pumpkins within 240 seconds. Use adjacency bonuses.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213339
    m_Localized: Harvest 65 tea within 240 seconds. Avoid overcrowding.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213340
    m_Localized: Harvest 50 starblooms within 300 seconds. Maintain energy supply.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213341
    m_Localized: A First Harvest
    m_Metadata:
      m_Items: []
  - m_Id: 662229213342
    m_Localized: A Hundred in Storage
    m_Metadata:
      m_Items: []
  - m_Id: 662229213343
    m_Localized: A Friend of Loops
    m_Metadata:
      m_Items: []
  - m_Id: 662229213344
    m_Localized: Automation Engineer
    m_Metadata:
      m_Items: []
  - m_Id: 662229213345
    m_Localized: Irrigation Specialist
    m_Metadata:
      m_Items: []
  - m_Id: 662229213346
    m_Localized: Companion Researcher
    m_Metadata:
      m_Items: []
  - m_Id: 662229213347
    m_Localized: Ten Thousand Steps
    m_Metadata:
      m_Items: []
  - m_Id: 662229213348
    m_Localized: Room to Grow
    m_Metadata:
      m_Items: []
  - m_Id: 662229213349
    m_Localized: Starbloom Breeder
    m_Metadata:
      m_Items: []
  - m_Id: 662229213350
    m_Localized: Research Pioneer
    m_Metadata:
      m_Items: []
  - m_Id: 662229213351
    m_Localized: Trial Collector
    m_Metadata:
      m_Items: []
  - m_Id: 662229213352
    m_Localized: Harvest 1 unit of crops in total.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213353
    m_Localized: Harvest 100 units of crops in total.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213354
    m_Localized: Harvest 1000 units of crops in total.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213355
    m_Localized: Perform 100 program actions.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213356
    m_Localized: Perform 5000 program actions.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213357
    m_Localized: Irrigate successfully 100 times.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213358
    m_Localized: Trigger 100 companion or adjacency harvest bonuses.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213359
    m_Localized: Move across 10000 plots.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213360
    m_Localized: Expand to an 8x8 field.
    m_Metadata:
      m_Items: []
  - m_Id: 662229213361
    m_Localized: Harvest 100 starblooms.
