  - m_Id: 1300716885893124
    m_Localized: UFO payload
    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893125
    m_Localized: Your orbital mothership connects four worlds. Choose Earth to descend.
    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893126
    m_Localized: Earth ecology
    m_Metadata:
      m_Items: []
