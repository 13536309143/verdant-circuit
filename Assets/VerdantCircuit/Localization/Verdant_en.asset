    m_Metadata:
      m_Items: []
  - m_Id: 1300716885893120
    m_Localized: "Green: production \xB7 blue: automation \xB7 amber: ecology \xB7
      violet: transport. Dark nodes are locked; bright nodes are researched."
    m_Metadata:
      m_Items: []
